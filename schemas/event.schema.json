{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "required": [
    "type",
    "utterance_id",
    "data",
    "ms_since_speech_end"
  ],
  "properties": {
    "type": {
      "enum": [
        "heard",
        "rejected",
        "route",
        "plan",
        "action",
        "done",
        "error",
        "confirm"
      ]
    },
    "utterance_id": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "ms_since_speech_end": {
      "type": "integer"
    }
  }
}
