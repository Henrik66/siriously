{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionResult",
  "type": "object",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot": {
      "oneOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "UISnapshot",
          "type": "object",
          "required": [
            "snapshot_id",
            "app",
            "items"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string"
            },
            "app": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "bundle_id": {
                  "type": "string"
                }
              }
            },
            "window": {
              "type": "string"
            },
            "focused_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "kind": {
                    "enum": [
                      "element",
                      "menu"
                    ]
                  },
                  "role": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "shortcut": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
